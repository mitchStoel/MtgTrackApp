# ==========================================
# EDH Nebula Tracker - Environment Config
# ==========================================

# Geheime sleutel voor sessie-cookies (gebruik een lange willekeurige tekst)
SECRET_KEY=vervang_dit_door_een_zeer_lange_willekeurige_sleutel_12345

# Stel zelf een sterk initieel wachtwoord in (alleen gebruikt bij een nieuwe database)
INITIAL_PASSWORD=

# Poort waarop de applicatie bereikbaar is op de host-server
APP_PORT=5000

# Locatie van de SQLite database binnen de container (gekopppeld aan Docker volume)
DB_PATH=/app/data/mtg_tracker.db